{
  "name": "apo-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/tokens-a-css.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && node scripts/generar-og-paginas.mjs && node scripts/verificar-metricas.mjs && astro build",
    "preview": "astro preview",
    "test:enlaces": "node scripts/test-enlaces.mjs",
    "test:contenido": "node scripts/test-posicionamiento.mjs",
    "build:borrador": "npm run tokens && node scripts/generar-og-paginas.mjs && astro build",
    "prepush": "npm run build && node scripts/test-posicionamiento.mjs --estricto && npm run test:seo && npm run test:enlaces && npm run test:formulario && npm run test:finder && npm run test:redirecciones",
    "test:formulario": "node scripts/test-formulario.mjs",
    "test:finder": "node scripts/test-finder.mjs",
    "test:redirecciones": "node scripts/test-redirecciones.mjs",
    "test:seo": "node scripts/test-seo.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1",
    "satori": "^0.63.2",
    "typescript": "^7.0.2"
  }
}