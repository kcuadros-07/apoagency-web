---
import Notificacion from './Notificacion.astro';
import PiezaMarketing from './PiezaMarketing.astro';
import { links } from '../config';
import { precioWebDesde } from '../data/metricas';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const L = links(d);
---

<section id="inicio" class="scroll-mt-20 pb-space-8 pt-[calc(44px+var(--spacing-space-4))] md:pt-[calc(44px+var(--spacing-space-8))]">
  <div class="wrap">
    <!-- Ventana de navegador: la web de APO "abierta". Nada de esta sección arranca invisible (LCP). -->
    <div class="ventana scope-dark">
      <div class="ventana-barra">
        <i></i><i></i><i></i>
        <span class="ventana-url">apoagency.io</span>
      </div>

      <div class="grid items-center gap-space-8 p-space-4 md:p-space-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <Notificacion lang={lang} />
          <h1 class="mt-space-8 max-w-[14ch] text-display">{d.hero.h1}</h1>
          <p class="mt-space-4 max-w-[38ch] text-ink-muted md:text-[18px]">{d.hero.sub}</p>

          <div class="mt-space-8 flex flex-col gap-space-2 sm:flex-row sm:flex-wrap">
            <a href={L.cotizar} class="btn btn-primary btn-pill" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 18.8L4 20Z"></path></svg>{d.hero.cotizar}
            </a>
            <a href={L.agenda} class="btn btn-ghost btn-pill" target="_blank" rel="noopener">{L.agendaTexto}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M7 17L17 7M8.500 7H17v8.500"></path></svg>
            </a>
          </div>
          <p class="mt-space-4 text-ink-muted">
            {d.hero.precio} <strong class="font-extrabold text-ink">{precioWebDesde}</strong>
          </p>
        </div>

        <PiezaMarketing lang={lang} />
      </div>
    </div>
  </div>
</section>
