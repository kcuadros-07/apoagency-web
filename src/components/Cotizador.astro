---
import FormCotizacion from './islas/FormCotizacion';
import SeccionCabecera from './SeccionCabecera.astro';
import { SITE } from '../config';
import { precios, m } from '../data/metricas';
import { t, ruta, type Lang } from '../i18n';

// Formulario de cotización por pasos: va DESPUÉS de "Hablemos", en su propio bloque.
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const H = d.hablemos;
// Solo viajan al navegador los números de precio (no las notas internas).
const p = Object.fromEntries(Object.entries(precios).map(([g, o]) => [g, Object.fromEntries(Object.entries(o).map(([k, v]) => [k, { desde: v.desde, mensual: 'mensual' in v ? v.mensual : undefined, porMes: 'porMes' in v ? v.porMes : undefined }]))]));
---

<section id="cotizar" class="seccion cv">
  <div class="wrap">
    <SeccionCabecera cinta={H.formCinta} titulo={H.formTitulo} sub={H.formSub} chico />
    <div class="mt-space-8" data-reveal="tarjeta">
      <FormCotizacion client:visible d={d.form} lang={lang} waNumber={SITE.whatsapp} formspreeId={SITE.formspreeId}
        privacidadHref={ruta(lang, 'privacidad')} precios={p as any} factor={Number(m('factorRango'))} pautaDia={m('pautaDiaria')} pautaMes={m('pautaMensual')} />
    </div>
  </div>
</section>

<style is:global>
  .cot-grid { display: grid; gap: 24px; align-items: start; }
  @media (min-width: 1024px) { .cot-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: 32px; } }
  /* Tarjeta blanca con sombra sólida (en tema oscuro, surface-raised). */
  .f-papel { padding: var(--spacing-space-4); }
  @media (min-width: 768px) { .f-papel { padding: var(--spacing-space-8); } }
  :root[data-theme='dark'] .f-papel { background: var(--c-surface-raised); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .f-papel { background: var(--c-surface-raised); } }
  .f-caja fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .f-caja legend { padding: 0; margin-bottom: 4px; }
  .f-caja fieldset + fieldset { margin-top: 32px; }
  .f-caja h3 + fieldset { margin-top: 20px; }
  .f-progreso { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .f-progreso i { height: 6px; border-radius: 6px; background: color-mix(in srgb, var(--c-ink) 14%, var(--c-surface)); transition: background-color 0.18s ease; }
  .f-progreso i.on { background: var(--c-indigo); }
  .f-paso { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; margin: 12px 0 var(--spacing-space-8); font: 500 14px/1.3 var(--font-mono); letter-spacing: 0.06em; color: var(--c-ink-muted); }
  .f-paso b { font-family: var(--font-sans); font-size: 16px; letter-spacing: 0; color: var(--c-ink); }
  @media (max-width: 767px) { .f-paso { font-size: 16px; } }
  .f-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--spacing-space-2); }
  .f-chips-grandes { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .chip { position: relative; display: inline-flex; }
  .chip-grande { display: flex; }
  .chip input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: inherit; }
  .chip span {
    display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 18px;
    border: 1.5px solid color-mix(in srgb, var(--c-ink) 28%, var(--c-surface)); border-radius: 16px;
    font-weight: 700; color: var(--c-ink); background: var(--c-surface);
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .chip-grande span { width: 100%; min-height: 64px; padding: 12px 18px; }
  .chip-con-icono { display: flex !important; align-items: center; gap: 14px; }
  .chip-con-icono > .chip-doble { display: flex; padding: 0 !important; min-height: 0 !important; border: 0 !important; background: transparent !important; color: inherit !important; width: auto !important; }
  .chip-doble { flex-direction: column; align-items: flex-start !important; gap: 2px !important; }
  .chip-doble b { font-weight: 800; line-height: 1.2; }
  .chip-doble small { font-size: 14px; font-weight: 600; color: var(--c-ink-muted); }
  .chip:hover span { border-color: var(--c-ink); }
  .chip input:checked + span { background: var(--c-indigo); border-color: var(--c-indigo); color: var(--c-on-indigo); }
  .chip input:checked + span small { color: var(--c-on-indigo); opacity: 0.9; }
  .chip input:focus-visible + span { outline: 3px solid var(--c-indigo-text); outline-offset: 3px; }
  .f-reco { margin-top: var(--spacing-space-4); padding: var(--spacing-space-4); border-left: 4px solid var(--c-indigo-text); background: var(--c-surface-raised); border-radius: var(--radius-sm); }
  :root[data-theme='dark'] .f-reco { background: var(--c-surface); }
  .f-reco-t { font: 700 16px/1.3 var(--font-mono); color: var(--c-indigo-text); margin-bottom: 4px; }
  .f-label { display: block; font-weight: 700; margin-bottom: 8px; }
  .f-input { width: 100%; min-height: 48px; padding: 10px 14px; font: inherit; color: var(--c-ink); background: var(--c-surface); border: 1.5px solid color-mix(in srgb, var(--c-ink) 28%, var(--c-surface)); border-radius: var(--radius-md); }
  .f-input:focus-visible { outline: 3px solid var(--c-indigo-text); outline-offset: 2px; }
  .f-input[aria-invalid='true'], .f-caja input[aria-invalid='true'] + span { border-color: var(--c-error); }
  .f-ayuda { margin-top: 6px; color: var(--c-ink-muted); font-size: 16px; }
  .f-error { margin-top: 6px; color: var(--c-error); font-weight: 600; }
  .f-errores { margin-bottom: var(--spacing-space-4); padding: var(--spacing-space-4); border: 1.5px solid var(--c-error); border-radius: var(--radius-md); }
  .f-errores ul { margin: 8px 0 0; padding-left: 20px; }
  .f-errores a { color: var(--c-error); text-decoration: underline; }
  .f-check { display: flex; gap: 12px; align-items: flex-start; min-height: 44px; }
  .f-check input { width: 24px; height: 24px; margin-top: 2px; accent-color: var(--c-indigo); flex: none; }
  .f-check a { color: var(--c-indigo-text); text-decoration: underline; }
  /* Columna lateral: "Lo que recibes" + rango estimado en vivo */
  .f-lado { display: grid; gap: 16px; }
  @media (min-width: 1024px) { .f-lado { position: sticky; top: 72px; } }
  .f-recibes { padding: 24px; border-radius: 24px; background: var(--c-surface-raised); }
  .f-recibes h3 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
  .f-recibes ul { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .f-recibes li { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; }
  .f-recibes li svg { flex: none; margin-top: 3px; color: var(--c-indigo-text); }
  .f-rango { padding: 24px; border-radius: 24px; background: var(--c-block-dark); color: #fff; }
  .f-rango-t { font: 600 14px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); }
  @media (max-width: 767px) { .f-rango-t { font-size: 16px; } }
  .f-rango-v { margin-top: 12px; font-size: clamp(34px, 4vw, 44px); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: #fff; }
  .f-rango-l { margin-top: 10px; color: rgba(255, 255, 255, 0.82); }
  .f-rango-n { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.18); font-size: 16px; color: rgba(255, 255, 255, 0.72); }
</style>
