---
import { Image } from 'astro:assets';
import lobo from '../assets/logos/apo-lobo-simbolo-oscuro.svg';
import kevin from '../assets/img/kevin-cuadros.png';
import { SITE, links } from '../config';
import { t, type Lang } from '../i18n';

// Referencia 02: bloque oscuro con cuadrícula sutil (la única de la web), etiqueta de papel, "Hablemos." gigante,
// sticker del lobo, iPhone inclinado con chat de WhatsApp, tarjeta blanca con el número y tarjeta de correo.
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const H = d.hablemos;
const wa = links(d).flotante;
const telefono = '+593 98 725 2978';
const flecha = 'M7 17L17 7M8.500 7H17v8.500';
---

<section id="hablemos" class="hablemos cv scope-dark grid-fondo relative overflow-hidden bg-block-dark text-ink">
  <div class="wrap relative py-12 md:py-space-16">
    <span class="papel-etiqueta">{H.etiqueta}</span>
    <h2 class="hablemos-t">{H.titulo}<span class="punto" aria-hidden="true"></span><span class="sr-only">.</span></h2>

    <!-- Sticker: el lobo de APO como recorte con borde blanco y sombra. -->
    <div class="sticker-lobo" aria-hidden="true"><Image src={lobo} alt="" width={84} height={81} loading="lazy" /></div>

    <div class="mt-space-4 grid items-center gap-space-8 lg:grid-cols-2 lg:gap-space-16">
      <div class="telefono-zona">
        <a href={wa} target="_blank" rel="noopener" class="telefono">
          <span class="cinta-tape t1" aria-hidden="true"></span><span class="cinta-tape t2" aria-hidden="true"></span>
          <span class="tel-pantalla" role="img" aria-label={H.telAria}>
            <span class="tel-isla"></span>
            <span class="tel-cab">
              <span class="tel-atras">‹</span>
              <Image src={kevin} alt="" width={40} height={40} class="tel-avatar" loading="lazy" />
              <span class="tel-nombre"><b>{H.chat.nombre}</b><small>{H.chat.lugar}</small></span>
              <span class="tel-llamar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e9edef" stroke-width="2" stroke-linecap="square"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
            </span>
            <span class="tel-chat">
              <span class="tel-hoy">{H.chat.hoy}</span>
              <span class="tel-burbuja">{H.chat.msg}<small>9:41</small></span>
            </span>
            <span class="tel-entrada">
              <span class="tel-campo">{H.chat.input}</span>
              <span class="tel-enviar"><svg width="18" height="18" viewBox="0 0 24 24" fill="#0b141a" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8Z"/></svg></span>
            </span>
          </span>
        </a>
        <span class="nota-tel" aria-hidden="true">{H.nota}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"><path d={flecha}></path></svg>
        </span>
      </div>

      <div class="grid gap-space-4">
        <a href={wa} target="_blank" rel="noopener" class="tarjeta-wa tarjeta">
          <span class="meta-bajo meta !text-[#4a4a55]">{H.wa}</span>
          <span class="tarjeta-wa-num">{telefono}</span>
          <svg class="tarjeta-wa-flecha" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d={flecha}></path></svg>
        </a>

        <div class="tarjeta-correo">
          <div class="min-w-0">
            <p class="meta meta-bajo">{H.correo}</p>
            <p class="mt-1 break-words text-[20px] font-medium md:text-[24px]">{SITE.email}</p>
          </div>
          <button type="button" class="copiar" data-copiar={SITE.email} data-copiado={H.copiado} data-copiar-txt={H.copiar}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M9 9h11v11H9zM5 15H4V4h11v1"></path></svg>
            <span data-copiar-label>{H.copiar}</span>
          </button>
          <span class="sr-only" role="status" data-copiar-estado></span>
        </div>

        <div class="flex flex-wrap gap-x-space-8">
          <a href={SITE.instagram} target="_blank" rel="noopener" class="meta meta-bajo flex min-h-[44px] items-center gap-space-2 no-underline hover:text-ink">
            {H.instagram} @apoagency
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d={flecha}></path></svg>
          </a>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="meta meta-bajo flex min-h-[44px] items-center gap-space-2 no-underline hover:text-ink">
            {H.linkedin} /in/kevincuadros
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d={flecha}></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copiar-label]')!;
      const estado = b.parentElement!.querySelector<HTMLElement>('[data-copiar-estado]');
      try {
        await navigator.clipboard.writeText(b.dataset.copiar || '');
      } catch {
        // Sin permiso de portapapeles: se selecciona el correo para copiarlo a mano.
        const r = document.createRange();
        const nodo = b.parentElement!.querySelector('p.break-words');
        if (nodo) { r.selectNodeContents(nodo); getSelection()?.removeAllRanges(); getSelection()?.addRange(r); }
      }
      label.textContent = b.dataset.copiado || '';
      if (estado) estado.textContent = b.dataset.copiado || '';
      setTimeout(() => { label.textContent = b.dataset.copiarTxt || ''; if (estado) estado.textContent = ''; }, 2000);
    });
  });
</script>

<style is:global>
  .papel-etiqueta { display: inline-block; background: #fff; color: var(--c-apo-black); font: 500 18px/1 var(--font-mono); padding: 10px 14px; transform: rotate(-2deg); box-shadow: 3px 3px 0 rgba(255, 255, 255, 0.22); }
  .hablemos-t { margin-top: var(--spacing-space-4); font-size: clamp(64px, 14.5vw, 205px); line-height: 0.86; font-weight: 800; letter-spacing: -0.075em; color: #fff; white-space: nowrap; }
  .hablemos-t .punto { width: 0.12em; height: 0.12em; margin-left: 0.04em; background: var(--c-indigo); }
  .sticker-lobo { position: absolute; top: 4px; right: 16px; width: 68px; height: 68px; display: grid; place-items: center; background: var(--c-apo-black); border: 6px solid #fff; border-radius: 28px; transform: rotate(8deg); box-shadow: 5px 6px 0 rgba(255, 255, 255, 0.2); }
  .sticker-lobo img { width: 42px; height: auto; }
  @media (min-width: 768px) { .sticker-lobo { top: 120px; right: 48px; width: 150px; height: 150px; } .sticker-lobo img { width: 92px; } }

  .telefono-zona { position: relative; display: grid; justify-items: center; padding: 28px 0 8px; }
  .telefono { position: relative; display: block; width: min(330px, 78vw); aspect-ratio: 9 / 19; transform: rotate(-4deg); padding: 10px; background: #1c1c22; border: 2px solid #2f2f38; border-radius: 48px; box-shadow: 14px 14px 0 rgba(255, 255, 255, 0.06); text-decoration: none; transition: transform 0.18s ease; }
  .telefono:hover { transform: rotate(-4deg) translateY(-2px); }
  .cinta-tape { position: absolute; z-index: 3; top: -14px; width: 104px; height: 32px; background: rgba(255, 255, 255, 0.3); backdrop-filter: blur(1px); }
  .cinta-tape.t1 { left: 10px; transform: rotate(-14deg); }
  .cinta-tape.t2 { right: 14px; transform: rotate(7deg); }
  .tel-pantalla { position: relative; display: flex; flex-direction: column; height: 100%; border-radius: 38px; overflow: hidden; background: #0b141a; color: #e9edef; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
  .tel-isla { position: absolute; z-index: 2; top: 10px; left: 50%; translate: -50% 0; width: 84px; height: 24px; background: #000; border-radius: 12px; }
  .tel-cab { display: flex; align-items: center; gap: 8px; padding: 44px 14px 10px; background: #111b21; }
  .tel-atras { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #202c33; font-size: 20px; line-height: 1; }
  .tel-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: top; background: #fff; }
  .tel-nombre { flex: 1; min-width: 0; line-height: 1.2; }
  .tel-nombre b { display: block; font-size: 15px; }
  .tel-nombre small { font-size: 13px; color: #8696a0; }
  .tel-llamar { display: grid; place-items: center; width: 36px; height: 30px; border-radius: 15px; background: #202c33; }
  .tel-chat { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 14px; }
  .tel-hoy { align-self: center; padding: 3px 10px; border-radius: 8px; background: #182229; font-size: 12px; color: #8696a0; }
  .tel-burbuja { align-self: flex-start; max-width: 88%; padding: 8px 10px 6px; border-radius: 12px 12px 12px 3px; background: #202c33; font-size: 15px; line-height: 1.35; }
  .tel-burbuja small { display: block; text-align: right; font-size: 11px; color: #8696a0; margin-top: 2px; }
  .tel-entrada { display: flex; align-items: flex-end; gap: 8px; padding: 10px 12px 18px; }
  .tel-campo { flex: 1; padding: 10px 14px; border-radius: 20px; background: #202c33; font-size: 14px; line-height: 1.3; color: #d1d7db; }
  .tel-enviar { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: #00a884; }
  .nota-tel { position: absolute; right: max(-8px, calc(50% - 250px)); bottom: 150px; z-index: 4; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; transform: rotate(-3deg); background: #fff; color: var(--c-apo-black); font: 700 26px/1 var(--font-hand); box-shadow: 3px 3px 0 rgba(255, 255, 255, 0.22); }

  .tarjeta-wa { position: relative; display: block; padding: 20px; background: #fff; color: var(--c-apo-black); text-decoration: none; border-radius: 4px; box-shadow: 10px 10px 0 color-mix(in srgb, #fff 38%, transparent); }
  @media (min-width: 768px) { .tarjeta-wa { padding: 28px 32px; } }
  .tarjeta-wa-num { display: block; margin-top: 14px; font-size: clamp(26px, 3.5vw, 52px); font-weight: 800; line-height: 1; letter-spacing: -0.05em; padding-right: 48px; white-space: nowrap; }
  .tarjeta-wa-flecha { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; }
  .tarjeta-correo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-space-4); padding: 20px 24px; border: 1px solid color-mix(in srgb, #fff 22%, transparent); border-radius: 22px; }
  .copiar { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; background: color-mix(in srgb, #fff 12%, transparent); color: #fff; font-weight: 600; transition: transform 0.18s ease, background-color 0.18s ease; }
  .copiar:hover { transform: translateY(-2px); background: color-mix(in srgb, #fff 20%, transparent); }
</style>
