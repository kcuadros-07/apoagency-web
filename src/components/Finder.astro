---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import FinderIsla from './islas/Finder';
import SeccionCabecera from './SeccionCabecera.astro';
import { t, type Lang } from '../i18n';

// "Mis proyectos": un Finder de macOS funcional (carpetas + íconos + previsualización). Referencia 05.
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const caps = import.meta.glob<{ default: ImageMetadata }>('../assets/capturas/*.webp', { eager: true });
const items = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);

const proyectos = await Promise.all(
  items.map(async (p) => {
    const meta = p.data.captura ? caps[`../assets/capturas/${p.data.captura}.webp`]?.default : undefined;
    let img;
    if (meta) {
      const thumb = await getImage({ src: meta, width: 280, height: 190, fit: 'cover', position: 'top', format: 'webp' });
      const big = await getImage({ src: meta, width: 720, height: 450, fit: 'cover', position: 'top', format: 'webp' });
      img = { thumb: thumb.src, big: big.src, w: 280, h: 190 };
    }
    return { id: p.id, nombre: p.data.nombre, cliente: p.data.cliente, categoria: p.data.categoria, servicio: p.data.servicio[lang], anio: p.data.anio, url: p.data.url, desc: p.data.desc[lang], img, mock: p.data.mock };
  }),
);
---

<section id="proyectos" class="seccion cv">
  <div class="wrap">
    <div class="rounded-lg bg-surface-raised p-space-4 md:p-space-16" data-reveal="tarjeta">
      <SeccionCabecera cinta={d.secciones.proyectos.cinta} titulo={d.secciones.proyectos.titulo} sub={d.secciones.proyectos.sub} nota />
      <div class="mt-space-8">
        <FinderIsla client:visible d={d.finder} proyectos={proyectos} />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .finder { background: var(--c-block-dark); color: var(--c-ink); border-radius: 18px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent); }
  .finder-barra { display: grid; grid-template-columns: 70px 1fr 70px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--c-hairline); }
  .finder-barra .puntos i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: rgba(255, 255, 255, 0.3); margin-right: 7px; }
  .finder-titulo { text-align: center; font-weight: 700; }
  .finder-cuerpo { display: grid; grid-template-columns: minmax(0, 1fr); min-height: 460px; }
  @media (min-width: 900px) { .finder-cuerpo { grid-template-columns: 210px minmax(0, 1fr) 290px; } }
  .finder-lado { display: flex; gap: 6px; overflow-x: auto; padding: 12px; border-bottom: 1px solid var(--c-hairline); background: color-mix(in srgb, #000 22%, transparent); }
  @media (min-width: 900px) { .finder-lado { flex-direction: column; overflow: visible; padding: 16px 12px; border-bottom: 0; border-right: 1px solid var(--c-hairline); } }
  .finder-sec { display: none; font: 600 13px/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-ink-muted); margin: 14px 8px 4px; }
  @media (min-width: 900px) { .finder-sec { display: block; font-size: 14px; } }
  .finder-lado button { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 12px; border-radius: 10px; white-space: nowrap; text-align: left; color: var(--c-ink); transition: background-color 0.18s ease; }
  .finder-lado button:hover { background: rgba(255, 255, 255, 0.07); }
  .finder-lado button[aria-pressed='true'] { background: rgba(255, 255, 255, 0.14); font-weight: 700; }
  .finder-lado button span { overflow: hidden; text-overflow: ellipsis; }
  .finder-lado button em { margin-left: auto; font-style: normal; font-size: 14px; color: var(--c-ink-muted); }
  @media (max-width: 899px) { .finder-lado button em { display: none; } }
  .finder-main { padding: 18px; min-width: 0; }
  .finder-cab { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .finder-cab span { color: var(--c-ink-muted); }
  .finder-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .finder-item { display: flex; flex-direction: column; align-items: stretch; gap: 6px; width: 100%; padding: 8px; border-radius: 12px; text-align: left; transition: background-color 0.18s ease; }
  .finder-item:hover { background: rgba(255, 255, 255, 0.06); }
  .finder-item[aria-pressed='true'] { background: rgba(255, 255, 255, 0.14); outline: 2px solid var(--c-indigo-text); }
  .finder-item[aria-pressed='true'] .finder-sub, .finder-lado button[aria-pressed='true'] em { color: var(--c-ink); }
  .finder-mini { display: block; aspect-ratio: 14 / 9.5; border-radius: 8px; overflow: hidden; background: var(--c-surface-raised); }
  .finder-mini > * { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .finder-nombre { font-weight: 700; line-height: 1.2; }
  .finder-sub { font-size: 14px; color: var(--c-ink-muted); }
  @media (max-width: 767px) { .finder-sub, .finder-prev dt, .finder-cab span { font-size: 16px; } }
  .finder-prev { padding: 18px; border-top: 1px solid var(--c-hairline); background: color-mix(in srgb, #000 18%, transparent); }
  @media (min-width: 900px) { .finder-prev { border-top: 0; border-left: 1px solid var(--c-hairline); } }
  .finder-prev-img { aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: var(--c-surface-raised); }
  .finder-prev-img > * { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .finder-prev h3 { margin-top: 16px; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .finder-desc { margin-top: 6px; color: var(--c-ink-muted); }
  .finder-prev dl { display: grid; gap: 6px; margin: 16px 0; }
  .finder-prev dl div { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--c-hairline); }
  .finder-prev dt { color: var(--c-ink-muted); }
  .finder-prev dd { font-weight: 700; text-align: right; }
  .finder-boton { background: #fff; color: var(--c-apo-black); }
  /* Mockups HTML de los proyectos sin captura */
  .fm { width: 100%; height: 100%; padding: 8%; display: flex; flex-direction: column; justify-content: center; gap: 6%; overflow: hidden; }
  .fm b { font-weight: 800; letter-spacing: -0.04em; line-height: 1; font-size: clamp(11px, 1.1vw, 14px); }
  .fm-portal b { font-size: clamp(10px, 0.95vw, 12px); }
  .fm-g.fm-portal b { font-size: clamp(16px, 2.2vw, 22px); }
  .fm-g b { font-size: clamp(20px, 3vw, 30px); }
  .fm small { font-size: 0.7em; opacity: 0.8; }
  .fm-portal { background: #fff; color: #0b0b0f; }
  .fm-barra { display: flex; gap: 4%; padding: 3%; border-radius: 99px; background: #f4f4f6; }
  .fm-barra i { flex: 1; height: 8px; border-radius: 9px; background: #d8d8de; }
  .fm-barra u { width: 22%; height: 8px; border-radius: 9px; background: #4f46e5; }
  .fm-props { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5%; }
  .fm-props i { aspect-ratio: 4 / 5; border-radius: 5px; background: linear-gradient(180deg, #d8d8de 60%, #f4f4f6 60%); }
  .fm-img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
